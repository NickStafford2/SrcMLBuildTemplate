#!/usr/bin/env python3
"""Preview or restore missing independent source checkouts from a saved snapshot."""
import argparse
from datetime import datetime, timezone
import json
from pathlib import Path
import shlex
import subprocess


def canonical_url(value):
    if value.startswith('git@github.com:'):
        value = 'https://github.com/' + value.split(':', 1)[1]
    return value.rstrip('/').removesuffix('.git')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true', help='clone missing repositories')
    parser.add_argument('--verify', action='store_true', help='check existing source revisions without network access')
    parser.add_argument('--capture', action='store_true', help='update the source snapshot after committing reviewed changes')
    parser.add_argument('--include-thesis', action='store_true', help='include private thesis and nested public final repository')
    args = parser.parse_args()
    if sum((args.apply, args.verify, args.capture)) > 1:
        parser.error('--apply, --verify and --capture are mutually exclusive')
    root = Path(__file__).resolve().parent.parent
    snapshot = json.loads((root / 'workspace.recovery.json').read_text())
    if snapshot.get('schema_version') != 1:
        raise SystemExit('Unsupported recovery snapshot')
    failed = False
    def git(path, *parts):
        return subprocess.check_output(['git', '-C', str(path), *parts], text=True).strip()
    def run(command):
        print(shlex.join(command), flush=True)
        if args.apply:
            subprocess.run(command, check=True)
    if args.capture:
        # Capture the complete set; omitting private repos would leave stale pins.
        for entry in snapshot['repositories']:
            path = root / entry['path']
            if git(path, 'status', '--porcelain', '--untracked-files=no'):
                raise SystemExit(f"Commit tracked changes before capture: {entry['path']}")
            branch = git(path, 'branch', '--show-current')
            if not branch:
                raise SystemExit(f"Select a named branch before capture: {entry['path']}")
            entry.update(url=git(path, 'remote', 'get-url', 'origin'), branch=branch,
                         commit=git(path, 'rev-parse', 'HEAD'))
            for ref in entry.get('additional_refs', []):
                ref.update(url=git(path, 'remote', 'get-url', ref['remote']),
                           commit=git(path, 'rev-parse', f"refs/heads/{ref['branch']}"))
        snapshot['observed_date'] = datetime.now(timezone.utc).date().isoformat()
        (root / 'workspace.recovery.json').write_text(json.dumps(snapshot, indent=2) + '\n')
        print('Updated workspace.recovery.json from committed checkouts; review and commit it in the root repo.')
        return 0
    for entry in snapshot['repositories']:
        if entry['path'].startswith('thesis-workspace') and not args.include_thesis:
            continue
        relative = Path(entry['path'])
        path = (root / relative).resolve()
        if relative.is_absolute() or '..' in relative.parts or not path.is_relative_to(root):
            raise SystemExit('Unsafe checkout path')
        if path.exists():
            if not (path / '.git').exists():
                print(f"BLOCKED {relative}: existing directory is not a checkout")
                failed = True
                continue
            matches = git(path, 'rev-parse', 'HEAD') == entry['commit']
            clean = not git(path, 'status', '--porcelain', '--untracked-files=no')
            origin = canonical_url(git(path, 'remote', 'get-url', 'origin')) == canonical_url(entry['url'])
            branch = git(path, 'branch', '--show-current') == entry['branch']
            state = 'OK' if matches and clean and origin and branch else 'DIFFERS'
            print(f'{state} {relative}: existing checkout is left unchanged')
            failed |= not (matches and clean and origin and branch)
            for ref in entry.get('additional_refs', []):
                observed = subprocess.run(['git', '-C', str(path), 'rev-parse', '--verify',
                                           f"refs/heads/{ref['branch']}"],
                                          text=True, capture_output=True)
                if observed.returncode or observed.stdout.strip() != ref['commit']:
                    print(f"DIFFERS {relative}: local {ref['branch']} does not match snapshot")
                    failed = True
            continue
        if args.verify:
            print(f'MISSING {relative}')
            failed = True
            continue
        # Only a newly cloned repository is moved to its recorded branch/commit.
        # Existing checkouts are never switched, reset, pulled or overwritten.
        run(['git', 'clone', '--branch', entry['branch'], entry['url'], str(path)])
        run(['git', '-C', str(path), 'switch', '-C', entry['branch'], entry['commit']])
        for ref in entry.get('additional_refs', []):
            run(['git', '-C', str(path), 'remote', 'add', ref['remote'], ref['url']])
            run(['git', '-C', str(path), 'fetch', ref['remote'],
                 f"refs/heads/{ref['branch']}:refs/remotes/{ref['remote']}/{ref['branch']}"])
            run(['git', '-C', str(path), 'branch', ref['branch'], ref['commit']])
            run(['git', '-C', str(path), 'branch', '--set-upstream-to',
                 f"{ref['remote']}/{ref['branch']}", ref['branch']])
    if not args.apply and not args.verify:
        print('Preview only. Add --apply to clone missing repositories.')
    return int(failed)


if __name__ == '__main__':
    raise SystemExit(main())
