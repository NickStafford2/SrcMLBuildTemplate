#!/usr/bin/env python3
"""Workspace commands for extending and publishing frozen history evidence."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument("action", choices=("more", "export", "status"))
parser.add_argument("--repository", choices=("notepadpp", "sqlite", "opencv", "linux"), default="notepadpp")
parser.add_argument("--count", type=int, default=100)
parser.add_argument("--jobs", type=int, default=4)
args = parser.parse_args()
if args.count <= 0 or args.jobs <= 0:
    parser.error("count and jobs must be positive")
compose = ["docker", "compose", "-f", str(root / "srcDiffVisual/compose.yaml"), "run", "--rm", "--no-deps", "srcdiffvisual"]
if Path("/.dockerenv").exists():
    # The workspace is already mounted in the Linux development container.
    # Admitted executables are copied into .srcmove and use analysis-relative
    # locators, so the same study can run through either container mount.
    repository = root / "srcMove/reference-repositories" / args.repository
    cli = [sys.executable, str(root / "srcMove/bin/srcmove-history"), "-C", str(repository)]
else:
    if shutil.which("docker") is None:
        parser.error("Docker is required on the host; alternatively run inside the workspace development shell")
    cli = compose + ["srcmove-history", "-C", f"/history/{args.repository}"]
if args.action == "more":
    result = subprocess.run(cli + ["run", "--more", str(args.count), "--jobs", str(args.jobs)])
    if result.returncode not in (0, 1):
        raise SystemExit(result.returncode)
    run_failed = result.returncode == 1
elif args.action == "status":
    subprocess.run(cli + ["status"], check=True)
if args.action in ("more", "export"):
    result = subprocess.run(cli + ["snapshot", "--format", "json"], capture_output=True, text=True)
    if result.returncode:
        raise SystemExit(result.stderr or result.stdout or "snapshot failed")
    document = json.loads(result.stdout)
    source = root / "srcMove/reference-repositories" / args.repository / ".srcmove/snapshots" / (document["snapshot_id"] + ".zip")
    destination = root / "thesis-workspace/data/srcMove-history" / args.repository / source.name
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if destination.read_bytes() != source.read_bytes():
            raise SystemExit("existing thesis snapshot has different bytes")
    else:
        shutil.copyfile(source, destination)
    print(destination)

if args.action == "more" and run_failed:
    raise SystemExit(1)
